{
  "name": "zmxy3-agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:forge": "tsx test/forge-mock.ts",
    "test:real": "tsx test/forge-real.ts",
    "test:mock": "tsx test/mock-game.ts",
    "test": "npm run test:unit && npm run test:forge && npm run test:mock"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.202",
    "@opencode-ai/sdk": "^1.17.14",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
